# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your API credentials.
# ==============================================================================

# Embedding Model (Hugging Face / sentence-transformers)
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Local Persisted ChromaDB Vector Store
CHROMA_PERSIST_DIR=data/vector_store
CHROMA_COLLECTION=harry_potter_books
TOP_K=3

# Google Gemini API Configuration (RAG Generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API Configuration (Query Routing & Chitchat)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
